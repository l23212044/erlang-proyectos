[Unit]
Description=P69 Camaras y accesos - bitacora de eventos (Erlang/OTP)
Documentation=https://github.com/l23212044/erlang-proyectos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=p69
Group=p69
SyslogIdentifier=p69-camaras-y-accesos
StateDirectory=p69-camaras-y-accesos
StateDirectoryMode=0750
WorkingDirectory=/opt/p69-camaras-y-accesos
Environment=HOME=/opt/p69-camaras-y-accesos
Environment=ERL_CRASH_DUMP=/var/lib/p69-camaras-y-accesos/erl_crash.dump
ExecStart=/opt/p69-camaras-y-accesos/bin/p69_camaras_y_accesos foreground
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/p69-camaras-y-accesos

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
