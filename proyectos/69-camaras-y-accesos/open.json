{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "nproc": "allow",
      "erl *": "allow",
      "rebar3 *": "allow",
      "curl http://localhost*": "allow",
      "curl http://127.0.0.1*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "deny",
      "sudo *": "ask",
      "rm -rf *": "deny"
    },
    "webfetch": "ask"
  }
}